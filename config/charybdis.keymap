#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
    tapping-term-ms = <175>;
    flavor = "balanced";

    //    quick-tap-ms = <100>;
};

//12.18 new Tag

/ {
    combos {
        compatible = "zmk,combos";

        Escape {
            bindings = <&kp ESCAPE>;
            key-positions = <2 3>;
            timeout-ms = <50>;
            layers = <0 2 1 5 6 7 10>;
        };

        del {
            bindings = <&kp DEL>;
            key-positions = <3 4>;
            timeout-ms = <50>;
            layers = <0 2 1 5 6 4 7 10>;
        };

        Expose {
            bindings = <&kp LC(UP_ARROW)>;
            key-positions = <31 32>;
            timeout-ms = <50>;
            layers = <0 2 1 5 6>;
        };

        Rshift_Rcmd {
            bindings = <&kp RS(RCMD)>;
            key-positions = <19 20>;
            timeout-ms = <30>;
            layers = <0 2 1 5 6>;
        };

        Lshift_Lcmd {
            bindings = <&kp LS(LCMD)>;
            key-positions = <15 16>;
            timeout-ms = <30>;
            layers = <0 2 1 5 6>;
        };

        Space {
            bindings = <&kp SPACE>;
            key-positions = <26 28>;
            layers = <1 0 2 5 6>;
            timeout-ms = <50>;
        };

        raycast {
            bindings = <&kp LG(SPACE)>;
            key-positions = <27 28>;
            timeout-ms = <50>;
            layers = <0 1 2 5 6>;
        };
    };

    behaviors {
        ht: ht {
            compatible = "zmk,behavior-hold-tap";
            label = "HT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <145>;
            quick-tap-ms = <50>;
            require-prior-idle-ms = <50>;
            flavor = "balanced";
        };

        ht_bck: ht_bck {
            compatible = "zmk,behavior-hold-tap";
            label = "HT_BCK";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <145>;
            quick-tap-ms = <0>;
            require-prior-idle-ms = <140>;
            flavor = "balanced";
            hold-trigger-key-positions = <12>;
        };

        lhmrow: lhmrow {
            compatible = "zmk,behavior-hold-tap";
            label = "LHMROW";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <170>;
            quick-tap-ms = <50>;
            require-prior-idle-ms = <50>;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <6 7 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 8 39 40 0>;
        };

        rhmrow: rhmrow {
            compatible = "zmk,behavior-hold-tap";
            label = "RHMROW";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <170>;
            require-prior-idle-ms = <50>;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38>;
            quick-tap-ms = <50>;
        };

        it_e: it_e {
            compatible = "zmk,behavior-hold-tap";
            label = "IT_E";
            bindings = <&it_shift_egrav>, <&it_egrav>;

            #binding-cells = <2>;
            tapping-term-ms = <145>;
            quick-tap-ms = <50>;
            require-prior-idle-ms = <50>;
            flavor = "balanced";
        };

        raycast: raycast {
            compatible = "zmk,behavior-tap-dance";
            label = "RAYCAST";
            #binding-cells = <0>;
            bindings = <&lt 4 LG(SPACE)>, <&kp LG(LC(SPACE))>;

            tapping-term-ms = <180>;
        };

        WisprFlow: WisprFlow {
            compatible = "zmk,behavior-tap-dance";
            label = "WISPRFLOW";
            #binding-cells = <0>;
            bindings = <&kp LC(LA(G))>, <&ht LA(LC(P)) LC(LA(B))>;

            tapping-term-ms = <190>;
        };

        mk_capt: mk_capt {
            compatible = "zmk,behavior-tap-dance";
            label = "MK_CAPT";
            #binding-cells = <0>;
            tapping-term-ms = <185>;
            bindings =
                <&ht LG(LS(LC(NUMBER_4))) LS(LG(NUMBER_2))>,
                <&ht LS(LG(N5)) LS(LG(NUMBER_4))>;
        };

        leftClick: leftClick {
            compatible = "zmk,behavior-hold-tap";
            label = "LEFTCLICK";
            #binding-cells = <2>;
            tapping-term-ms = <120>;
            flavor = "hold-preferred";
            bindings = <&mo>, <&mkp>;
        };

        ameth: ameth {
            compatible = "zmk,behavior-hold-tap";
            label = "AMETH";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <180>;
        };

        TD1: TD1 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD1";
            #binding-cells = <0>;
            bindings = <&NumbersLayer 1 SPACE>, <&mo 9>;

            tapping-term-ms = <150>;
        };

        TD1_mlayer: TD1_mlayer {
            compatible = "zmk,behavior-tap-dance";
            label = "TD1_MLAYER";
            #binding-cells = <0>;
            tapping-term-ms = <150>;
            bindings = <&leftClick 1 RCLK>, <&mo 9>;
        };

        NumbersLayer: NumbersLayer {
            compatible = "zmk,behavior-hold-tap";
            label = "NUMBERSLAYER";
            #binding-cells = <2>;
            tapping-term-ms = <120>;
            flavor = "hold-preferred";
            bindings = <&mo>, <&kp>;
        };
    };

    macros {
        it_egrav: it_grav {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(GRAVE) &kp E>;
            label = "IT_GRAV";
        };

        it_shift_egrav: it_shift_egrav {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(E) &kp E>;
            label = "IT_SHIFT_EGRAV";
        };

        it_i: it_i {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(GRAVE) &kp I>;
            label = "IT_I";
        };

        it_o: it_o {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(GRAVE) &kp O>;
            label = "IT_O";
        };

        it_u: it_u {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(GRAVE) &kp U>;
            label = "IT_U";
        };

        it_a: it_a {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(GRAVE) &kp A>;
            label = "IT_A";
        };

        efp: efp {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp UNDER &kp F &kp P>;
            label = "EFP";
        };

        elaugh: elaugh {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp UNDER &kp L &kp A>;
            label = "ELAUGH";
        };

        eok: eok {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp UNDER &kp O &kp K>;
            label = "EOK";
        };

        ethank: ethank {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp UNDER &kp T &kp H>;
            label = "ETHANK";
        };

        esmile: esmile {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp UNDER &kp S &kp M>;
            label = "ESMILE";
        };

        esad: esad {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp UNDER &kp S &kp A &kp D>;
            label = "ESAD";
        };

        elove: elove {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp UNDER &kp L &kp V>;
            label = "ELOVE";
        };

        ehmmm: ehmmm {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp UNDER &kp H &kp M>;
            label = "EHMMM";
        };

        ecoffe: ecoffe {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp UNDER &kp C &kp F>;
            label = "ECOFFE";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Colemak {
            bindings = <
&ht LS(TAB) TAB             &ht LG(Q) Q      &ht LG(W) W     &ht LG(F) F       &kp P           &kp G            &kp J        &kp L           &kp U                &ht LA(LG(LS(Y))) Y      &ht COLON SEMICOLON     &ht PIPE BACKSLASH
&ht_bck LA(BSPC) BACKSPACE  &lhmrow LCTRL A  &lhmrow LALT R  &lhmrow LSHIFT S  &lhmrow LGUI T  &kp D            &kp H        &rhmrow RGUI N  &rhmrow RSHFT E      &rhmrow RALT I           &rhmrow LEFT_CONTROL O  &ht DOUBLE_QUOTES SQT
&WisprFlow                  &ht LG(Z) Z      &ht LG(X) X     &ht LG(C) C       &ht LG(V) V     &ht LG(B) B      &ht PLUS K   &ht MINUS M     &ht LESS_THAN COMMA  &ht GREATER_THAN PERIOD  &ht QUESTION SLASH      &ht LC(DOWN) LC(UP_ARROW)
                                                             &raycast          &TD1            &lt 6 ENTER      &lt 3 ENTER  &lt 2 SPACE
            >;
        };

        Numbers {
            bindings = <
&trans         &kp LS(EXCL)                &kp LS(AT)               &kp LS(POUND)                      &kp LS(DLLR)                         &kp LS(PRCNT)      &kp LS(CARET)   &kp LS(AMPS)          &kp LS(STAR)       &kp LS(LPAR)     &kp LS(RPAR)             &kp CAPSLOCK
&kp BACKSPACE  &lhmrow LCTRL NUMBER_1      &lhmrow LALT NUMBER_2    &lhmrow LSHFT NUMBER_3             &lhmrow LGUI NUMBER_4                &kp N5             &kp NUMBER_6    &rhmrow RGUI N7       &rhmrow RSHIFT N8  &rhmrow RALT N9  &rhmrow LEFT_CONTROL N0  &ht PLUS EQUAL
&mk_capt       &ht LC(LS(TAB)) LEFT_BRACE  &ht LC(TAB) RIGHT_BRACE  &ht LG(LEFT_BRACKET) LEFT_BRACKET  &ht LG(RIGHT_BRACKET) RIGHT_BRACKET  &trans             &ht PLUS EQUAL  &ht UNDERSCORE MINUS  &trans             &trans           &trans                   &ht GRAVE TILDE
                                                                    &trans                             &trans                               &trans             &trans          &trans
            >;
        };

        Move {
            bindings = <
&trans         &trans     &trans    &trans     &trans    &trans         &kp DEL       &kp LA(LEFT)  &kp UP    &kp LA(RIGHT)  &trans    &kp PG_UP
&kp BACKSPACE  &kp LCTRL  &kp LALT  &kp LSHFT  &kp LGUI  &kp RET        &kp LG(UP)    &kp LEFT      &kp DOWN  &kp RIGHT      &kp INS   &kp PAGE_DOWN
&trans         &trans     &trans    &trans     &trans    &kp SPACE      &kp LG(DOWN)  &kp LG(LEFT)  &trans    &kp LG(RIGHT)  &kp HOME  &kp END
                                    &trans     &trans    &trans         &trans        &trans
            >;
        };

        Italian {
            bindings = <
&kp C_PREV  &kp C_PP    &kp C_NEXT        &kp K_MUTE        &kp C_VOL_DN      &kp C_VOL_UP      &kp LS(LG(LC(LA(P))))  &trans      &it_u       &trans      &trans      &kp LG(LC(LA(LS(A))))
&trans      &it_a       &trans            &trans            &trans            &trans            &trans                 &trans      &it_e 0 0   &it_i       &it_o       &kp LG(LC(LA(LS(Z))))
&trans      &kp LG(N1)  &kp LG(NUMBER_2)  &kp LG(NUMBER_3)  &kp LG(NUMBER_4)  &kp LG(N5)        &kp LG(NUMBER_6)       &kp LG(N7)  &kp LG(N8)  &kp LG(N9)  &kp LG(N0)  &trans
                                          &trans            &trans            &trans            &trans                 &trans
            >;
        };

        Emoji {
            bindings = <
&trans      &trans    &elove     &efp       &ehmmm     &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans      &elaugh   &esmile    &eok       &ethank    &esad       &trans  &trans  &trans  &trans  &trans  &trans
&kp LSHIFT  &kp LGUI  &mkp LCLK  &mkp MCLK  &mkp RCLK  &trans      &trans  &trans  &trans  &trans  &trans  &kp LCTRL
                                 &trans     &trans     &trans      &trans  &trans
            >;
        };

        Mouse {
            bindings = <
&trans  &trans  &trans  &trans     &trans       &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans     &trans       &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans     &trans       &trans      &trans  &trans  &trans  &trans  &trans  &trans
                        &mkp LCLK  &TD1_mlayer  &mo 6       &trans  &trans
            >;
        };

        MouseScroll {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans      &trans  &trans
            >;
        };

        MouseSniper {
            bindings = <
&trans  &trans  &trans  &trans     &trans     &trans         &trans  &trans  &trans  &trans  &trans  &to 5
&trans  &trans  &trans  &trans     &trans     &trans         &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans     &trans     &trans         &trans  &trans  &trans  &trans  &trans  &to 0
                        &mkp LCLK  &mkp RCLK  &mkp MCLK      &trans  &trans
            >;
        };

        BT_Sys {
            bindings = <
&kp F1       &kp F2        &kp F3        &kp F4        &kp F5        &kp F6            &kp F7        &kp F8    &kp F9     &kp F10   &kp F11    &kp F12
&bt BT_CLR   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4      &out OUT_USB  &kp RGUI  &kp RSHFT  &kp RALT  &kp LCTRL  &out OUT_BLE
&bootloader  &kp N1        &kp N2        &kp N3        &kp N4        &kp N5            &kp N6        &kp N7    &kp N8     &kp N9    &kp N0     &bootloader
                                         &trans        &trans        &trans            &trans        &trans
            >;
        };

        Amethyst {
            bindings = <
&none   &none            &none                  &none              &none          &none      &kp LA(LS(A))  &kp LS(LA(L))  &kp LS(LA(U))  &none                 &kp LS(LA(ENTER))      &kp LA(LS(SPACE))
&trans  &kp LS(LA(SQT))  &kp LS(LA(SEMICOLON))  &kp LC(LEFT)       &kp LC(RIGHT)  &none      &kp LS(LA(T))  &kp LA(LS(N))  &kp LS(LA(E))  &kp LA(LS(LC(LEFT)))  &kp LS(LA(LC(RIGHT)))  &none
&none   &none            &none                  &none              &none          &none      &kp LS(LA(D))  &kp LS(LA(K))  &kp LS(LA(J))  &none                 &kp LS(LA(COMMA))      &kp LS(LA(PERIOD))
                                                &kp LS(LA(LC(Z)))  &none          &none      &kp LS(LA(B))  &kp LS(LA(O))
            >;

            label = "Amethyst";
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        BT_SYS {
            if-layers = <3 6>;
            then-layer = <8>;
        };
    };
};
