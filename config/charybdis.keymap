#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/*
&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};
*/

/ {
    combos {
        compatible = "zmk,combos";

        Escape {
            bindings = <&kp ESCAPE>;
            key-positions = <2 3>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0 2 1>;
        };

        del {
            bindings = <&kp DEL>;
            key-positions = <3 4>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0 2 1>;
        };

        cmd_shift_left {
            bindings = <&kp LG(LSHIFT)>;
            key-positions = <16 15>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0 2 1>;
        };

        cmd_shift_right {
            bindings = <&kp RG(RSHIFT)>;
            key-positions = <19 20>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0 2 1>;
        };

        ctrl_cmd_left {
            bindings = <&kp LC(LCMD)>;
            key-positions = <16 13>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0 2 1>;
        };

        ctrl_cmd_right {
            bindings = <&kp RC(RGUI)>;
            key-positions = <19 22>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0 2 1>;
        };

        alt_cmd_right {
            bindings = <&kp RG(RIGHT_ALT)>;
            key-positions = <21 19>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0 2 1>;
        };

        alt_cmd_left {
            bindings = <&kp LG(LEFT_ALT)>;
            key-positions = <16 14>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0 2 1>;
        };

        alt_shift_left {
            bindings = <&kp LA(LSHIFT)>;
            key-positions = <14 15>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0 2 1>;
        };

        alt_shift_right {
            bindings = <&kp RA(RSHIFT)>;
            key-positions = <20 21>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0 2 1>;
        };

        ctrl_alt_shift {
            bindings = <&kp LA(LC(LSHIFT))>;
            key-positions = <13 14 15>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0 1 2>;
        };

        ctrl_alt_shift_right {
            bindings = <&kp RA(RC(RSHIFT))>;
            key-positions = <20 21 22>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0 1 2>;
        };

        shortcat {
            bindings = <&kp RG(RS(RA(SLASH)))>;
            key-positions = <8 9>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0 1 2>;
        };
    };

    behaviors {
        ht: ht {
            compatible = "zmk,behavior-hold-tap";
            label = "HT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <145>;
            quick-tap-ms = <50>;
            require-prior-idle-ms = <50>;
            flavor = "balanced";
        };

        ht_bck: ht_bck {
            compatible = "zmk,behavior-hold-tap";
            label = "HT_BCK";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <145>;
            quick-tap-ms = <0>;
            require-prior-idle-ms = <140>;
            flavor = "balanced";
            hold-trigger-key-positions = <12>;
        };

        lhmrow: lhmrow {
            compatible = "zmk,behavior-hold-tap";
            label = "LHMROW";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <170>;
            quick-tap-ms = <30>;
            require-prior-idle-ms = <100>;
            flavor = "balanced";
            hold-trigger-key-positions = <6 7 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 8 39 40 0>;
        };

        rhmrow: rhmrow {
            compatible = "zmk,behavior-hold-tap";
            label = "RHMROW";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <170>;
            quick-tap-ms = <30>;
            require-prior-idle-ms = <100>;
            flavor = "balanced";
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38>;
        };

        dt_ameth: dt_ameth {
            compatible = "zmk,behavior-tap-dance";
            label = "DT_AMETH";
            #binding-cells = <0>;
            bindings = <&kp LA(LS(O))>, <&kp LA(LS(D))>, <&kp LS(LA(LC(J)))>;

            tapping-term-ms = <180>;
        };

        it_e: it_e {
            compatible = "zmk,behavior-hold-tap";
            label = "IT_E";
            bindings = <&it_shift_egrav>, <&it_egrav>;

            #binding-cells = <2>;
            tapping-term-ms = <145>;
            quick-tap-ms = <50>;
            require-prior-idle-ms = <50>;
            flavor = "balanced";
        };

        raycast: raycast {
            compatible = "zmk,behavior-tap-dance";
            label = "RAYCAST";
            #binding-cells = <0>;
            bindings = <&lt 5 LG(SPACE)>, <&kp LG(LC(SPACE))>;

            tapping-term-ms = <180>;
        };

        leftcmd: leftcmd {
            compatible = "zmk,behavior-tap-dance";
            label = "LEFTCMD";
            #binding-cells = <0>;
            bindings = <&ht LGUI ENTER>, <&Layers 6 6>;

            tapping-term-ms = <185>;
        };

        WisprFlow: WisprFlow {
            compatible = "zmk,behavior-tap-dance";
            label = "WISPRFLOW";
            #binding-cells = <0>;
            bindings = <&kp LC(LA(G))>, <&ht LA(LC(P)) LC(LA(B))>;

            tapping-term-ms = <190>;
        };

        Layers: Layers {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYERS";
            bindings = <&mo>, <&to>;

            #binding-cells = <2>;
            tapping-term-ms = <145>;
            quick-tap-ms = <50>;
            require-prior-idle-ms = <50>;
            flavor = "balanced";
        };

        mk_capt: mk_capt {
            compatible = "zmk,behavior-tap-dance";
            label = "MK_CAPT";
            #binding-cells = <0>;
            tapping-term-ms = <185>;
            bindings =
                <&ht LG(LS(LC(NUMBER_4))) LS(LC(LG(NUMBER_2)))>,
                <&ht LS(LG(N5)) LS(LG(NUMBER_4))>;
        };
    };

    macros {
        it_egrav: it_grav {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(GRAVE) &kp E>;
            label = "IT_GRAV";
        };

        it_shift_egrav: it_shift_egrav {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(E) &kp E>;
            label = "IT_SHIFT_EGRAV";
        };

        it_i: it_i {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(GRAVE) &kp I>;
            label = "IT_I";
        };

        it_o: it_o {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(GRAVE) &kp O>;
            label = "IT_O";
        };

        it_u: it_u {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(GRAVE) &kp U>;
            label = "IT_U";
        };

        it_a: it_a {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(GRAVE) &kp A>;
            label = "IT_A";
        };

        efp: efp {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp UNDER &kp F &kp P>;
            label = "EFP";
        };

        elaugh: elaugh {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp UNDER &kp L &kp A>;
            label = "ELAUGH";
        };

        eok: eok {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp UNDER &kp O &kp K>;
            label = "EOK";
        };

        ethank: ethank {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp UNDER &kp T &kp H>;
            label = "ETHANK";
        };

        esmile: esmile {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp UNDER &kp S &kp M>;
            label = "ESMILE";
        };

        esad: esad {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp UNDER &kp S &kp A &kp D>;
            label = "ESAD";
        };

        elove: elove {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp UNDER &kp L &kp V>;
            label = "ELOVE";
        };

        ehmmm: ehmmm {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp UNDER &kp H &kp M>;
            label = "EHMMM";
        };

        ecoffe: ecoffe {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp UNDER &kp C &kp F>;
            label = "ECOFFE";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Colemak {
            bindings = <
&ht LS(TAB) TAB             &ht LG(Q) Q      &ht LG(W) W     &ht LG(F) F       &kp P           &kp G                &kp J        &kp L           &kp U                &kp Y                    &ht COLON SEMICOLON  &ht PIPE NON_US_BACKSLASH
&ht_bck LA(BSPC) BACKSPACE  &lhmrow LCTRL A  &lhmrow LALT R  &lhmrow LSHIFT S  &lhmrow LGUI T  &kp D                &kp H        &rhmrow RGUI N  &rhmrow RSHFT E      &rhmrow RALT I           &rhmrow RCTRL O      &ht DOUBLE_QUOTES SQT
&WisprFlow                  &ht LG(Z) Z      &ht LG(X) X     &ht LG(C) C       &ht LG(V) V     &ht LS(LA(O)) B      &kp K        &kp M           &ht LESS_THAN COMMA  &ht GREATER_THAN PERIOD  &ht QUESTION SLASH   &bootloader
                                                             &raycast          &lt 1 SPACE     &leftcmd             &lt 4 ENTER  &lt 2 SPACE
            >;
        };

        Numbers {
            bindings = <
&trans         &kp LS(EXCL)                 &kp LS(AT)                   &kp LS(POUND)               &kp LS(DLLR)                 &kp LS(PRCNT)      &kp LS(CARET)   &kp LS(AMPS)          &kp LS(STAR)       &kp LS(LPAR)     &kp LS(RPAR)      &kp CAPSLOCK
&kp BACKSPACE  &lhmrow LCTRL NUMBER_1       &lhmrow LALT NUMBER_2        &lhmrow LSHFT NUMBER_3      &lhmrow LGUI NUMBER_4        &kp N5             &kp NUMBER_6    &rhmrow RGUI N7       &rhmrow RSHIFT N8  &rhmrow RALT N9  &rhmrow RCTRL N0  &ht PLUS EQUAL
&mk_capt       &ht LEFT_BRACE LEFT_BRACKET  &ht RIGHT_BRACE RIGHT_BRACE  &ht LS(LA(LC(W))) LC(LEFT)  &ht LS(LC(LA(E))) LC(RIGHT)  &dt_ameth          &ht PLUS EQUAL  &ht UNDERSCORE MINUS  &trans             &trans           &trans            &ht GRAVE TILDE
                                                                         &kp LS(LA(B))               &lt 2 SPACE                  &trans             &lt 4 ENTER     &lt 3 SPACE
            >;
        };

        Move {
            bindings = <
&trans  &trans     &trans    &trans     &trans    &trans         &kp DEL       &kp LA(LEFT)  &kp UP    &kp LA(RIGHT)  &trans    &kp PG_UP
&trans  &kp LCTRL  &kp LALT  &kp LSHFT  &kp LGUI  &kp RET        &kp LG(UP)    &kp LEFT      &kp DOWN  &kp RIGHT      &kp INS   &kp PAGE_DOWN
&trans  &trans     &trans    &trans     &trans    &kp SPACE      &kp LG(DOWN)  &kp LG(LEFT)  &trans    &kp LG(RIGHT)  &kp HOME  &kp END
                             &trans     &trans    &trans         &trans        &trans
            >;
        };

        BT_Sys {
            bindings = <
&kp F1       &kp F2        &kp F3        &kp F4        &kp F5        &kp F6            &kp F7        &kp F8    &kp F9     &kp F10   &kp F11    &kp F12
&bt BT_CLR   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4      &out OUT_USB  &kp RGUI  &kp RSHFT  &kp RALT  &kp LCTRL  &out OUT_BLE
&bootloader  &kp N1        &kp N2        &kp N3        &kp N4        &kp N5            &kp N6        &kp N7    &kp N8     &kp N9    &kp N0     &bootloader
                                         &trans        &trans        &trans            &trans        &trans
            >;
        };

        Italian {
            bindings = <
&kp C_PREV  &kp C_PP    &kp C_NEXT        &kp K_MUTE        &kp C_VOL_DN      &kp C_VOL_UP      &kp LS(LG(LC(LA(P))))  &trans      &it_u       &trans      &trans      &kp LG(LC(LA(LS(A))))
&trans      &it_a       &trans            &trans            &trans            &trans            &trans                 &trans      &it_e 0 0   &it_i       &it_o       &kp LG(LC(LA(LS(Z))))
&trans      &kp LG(N1)  &kp LG(NUMBER_2)  &kp LG(NUMBER_3)  &kp LG(NUMBER_4)  &kp LG(N5)        &kp LG(NUMBER_6)       &kp LG(N7)  &kp LG(N8)  &kp LG(N9)  &kp LG(N0)  &trans
                                          &trans            &trans            &trans            &trans                 &trans
            >;
        };

        Emoji {
            bindings = <
&trans      &trans    &elove     &efp       &ehmmm     &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans      &elaugh   &esmile    &eok       &ethank    &esad       &trans  &trans  &trans  &trans  &trans  &trans
&kp LSHIFT  &kp LGUI  &mkp LCLK  &mkp MCLK  &mkp RCLK  &trans      &trans  &trans  &trans  &trans  &trans  &kp LCTRL
                                 &trans     &trans     &trans      &trans  &trans
            >;
        };

        Mouse {
            bindings = <
&trans          &trans    &trans          &msc SCRL_UP    &trans           &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans          &trans    &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_RIGHT  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&kp LEFT_SHIFT  &kp LGUI  &mkp LCLK       &mkp MCLK       &mkp RCLK        &trans      &trans  &trans  &trans  &trans  &trans  &trans
                                          &trans          &trans           &to 0       &trans  &trans
            >;
        };

        MouseSniper {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans      &trans  &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        BT_SYS {
            if-layers = <2 1>;
            then-layer = <3>;
        };
    };
};
